{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SayQL",
  "version": "0.2.1",
  "identifier": "com.sayql.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SayQL",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SayQL",
    "copyright": "Copyright © 2026 Adith L S. SayQL Community Edition, open source under the Apache License 2.0.",
    "category": "DeveloperTool",
    "shortDescription": "AI-first database client",
    "longDescription": "SayQL Community Edition is a free desktop database client for PostgreSQL, MySQL, SQLite, SQL Server and Azure SQL. Ask a question in plain English and get SQL as you type, written by the AI you choose, then run it against your database with a fast, keyboard-first editor.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../PRIVACY.md": "PRIVACY.md",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGQzVBQ0ZFRjNDRDQ0QTMKUldTalJNM3ovcXpGRDZZTXlnbGgwcmZ4dW9tSGV6cWRacEV3SXRKV1ByZ3R6VjhVWlJuTW1VdFAK",
      "endpoints": [
        "https://github.com/dithzz/sayql-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
